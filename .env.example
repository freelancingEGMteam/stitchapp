NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Enables address autocomplete on the public booking page and
# lets it check the address is inside the travel area. Without it the
# address is a plain required text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- New-booking email alerts ---------------------------------------------
# The database trigger in supabase/schema-notify.sql posts each new booking
# request to /api/notify, which sends the email over Gmail SMTP.
# With any of these unset, alerts are simply off and bookings still work.
#
# NOTIFY_SECRET must match the notify_secret row in studio_settings. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_SECRET=

# A Gmail account and a 16-character App Password for it. The App Password
# needs 2-Step Verification turned on: https://myaccount.google.com/apppasswords
# The same credentials can be entered in Supabase under Authentication ->
# Emails -> SMTP Settings, which also lifts the 2-emails-per-hour limit on
# magic-link and password-reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the alert is sent. Defaults to GMAIL_USER when unset. Comma-separate
# for more than one recipient is not supported; use a Gmail filter to forward.
NOTIFY_TO=

# Optional. Adds a "open the app" link to the alert email.
NOTIFY_APP_URL=
